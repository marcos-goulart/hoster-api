# ==========================================
# HOSTER API - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# Ambiente de Execução (development | production | test)
NODE_ENV=development

# Porta do Servidor Express
PORT=3001

# Conexão com o Banco de Dados PostgreSQL (Neon Serverless ou Local)
# Exemplo: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/hoster_db?sslmode=require"

# Credenciais de Serviço do Firebase Admin SDK
FIREBASE_PROJECT_ID="hoster-hotels-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@hoster-hotels-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

