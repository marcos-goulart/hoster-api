datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Usuários (Sincronizado com UID do Firebase Auth)
model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique
  name        String
  email       String   @unique
  avatar      String?
  phone       String?
  document    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings  Booking[]
  favorites Favorite[]

  @@map("users")
}

// 2. Estabelecimentos / Hotéis
model Hotel {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  address     String
  city        String
  state       String
  ratingScore Float    @default(5.0)
  reviewCount Int      @default(0)
  mapEmbedUrl String?  @db.Text
  photos      String[]
  amenities   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms     Room[]
  reviews   Review[]
  favorites Favorite[]

  @@map("hotels")
}

// 3. Tipos de Quartos do Hotel
model Room {
  id            String   @id @default(uuid())
  hotelId       String
  title         String
  subtitle      String?
  pricePerNight Float
  capacity      Int      @default(2)
  isAvailable   Boolean  @default(true)
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("rooms")
}

// 4. Reservas (Bookings)
model Booking {
  id                String        @id @default(uuid())
  userId            String
  roomId            String
  checkIn           DateTime
  checkOut          DateTime
  nights            Int
  guestsCount       Int
  roomPricePerNight Float
  serviceFee        Float         @default(120.0)
  totalPrice        Float
  status            BookingStatus @default(CONFIRMED)

  guestFullName String
  guestEmail    String
  guestDocument String
  guestPhone    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// 5. Avaliações dos Hóspedes
model Review {
  id         String   @id @default(uuid())
  hotelId    String
  userName   String
  userAvatar String?
  rating     Int      @default(5)
  stayDate   String
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// 6. Favoritos dos Usuários
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  hotelId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@map("favorites")
}
